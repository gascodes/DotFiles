# ==========================
# CYBERPUNK PS1 + RELOJ
# ==========================

# Reset
RESET="\[\e[0m\]"
BOLD="\[\e[1m\]"

# Neon colors
NEON_PINK="\[\e[38;5;198m\]"
NEON_CYAN="\[\e[38;5;51m\]"
NEON_GREEN="\[\e[38;5;46m\]"
NEON_PURPLE="\[\e[38;5;129m\]"
NEON_RED="\[\e[38;5;196m\]"
NEON_YELLOW="\[\e[38;5;226m\]"
NEON_BLUE="\[\e[38;5;45m\]"

# Git branch
git_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null
}

# Exit status
exit_status() {
  if [ $? -ne 0 ]; then
    echo "${NEON_RED}✖ "
  fi
}

# Clock function
clock() {
  date +"%H:%M:%S"
}

# Enable command substitution inside PS1
shopt -s promptvars

PS1="\n"

# Top line
PS1+="${NEON_PINK}┌─${RESET}"
PS1+=" ${NEON_BLUE} \$(clock) ${RESET}"
PS1+="${NEON_PURPLE}──${RESET}"
PS1+=" ${NEON_CYAN} \u@\H ${RESET}"
PS1+="${NEON_PURPLE}──${RESET}"
PS1+=" ${NEON_GREEN}\w ${RESET}"

# Git branch (if exists)
#PS1+='${NEON_YELLOW}$(branch=$(git_branch); if [ -n "$branch" ]; then echo "──  $branch "; fi)'

# Bottom line
PS1+="\n"
PS1+="${NEON_PINK}└─${RESET}"
PS1+='$(exit_status)'
PS1+="${NEON_CYAN}▶ ${RESET}"
